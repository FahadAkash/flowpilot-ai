# FlowPilot AI Environment Configuration
# Copy to .env and fill in keys for live LLM providers.
# Leave API keys blank to run with the built-in deterministic MockProvider.

FLOWPILOT_ENV=development
FLOWPILOT_SECRET_KEY=dev-only-change-in-production-flowpilot-secret-key-32bytes
FLOWPILOT_DATABASE_URL=postgresql+asyncpg://flowpilot:flowpilot@localhost:5432/flowpilot
FLOWPILOT_REDIS_URL=redis://localhost:6379/0
FLOWPILOT_CELERY_BROKER_URL=redis://localhost:6379/1
FLOWPILOT_CELERY_RESULT_BACKEND=redis://localhost:6379/2
FLOWPILOT_STORAGE_DIR=./storage/documents
FLOWPILOT_CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# LLM Provider Configuration (mock | lmstudio | openai | gemini | anthropic | ollama)
FLOWPILOT_LLM_PROVIDER=mock
FLOWPILOT_TIER1_MODEL=gpt-4o-mini
FLOWPILOT_TIER2_MODEL=gpt-4o-mini
FLOWPILOT_TIER3_MODEL=gpt-4o

# Optional Local LM Studio (OpenAI-compatible chat + 768-dim neural embeddings)
LM_STUDIO_BASE_URL=http://localhost:1234
LM_STUDIO_CHAT_MODEL=google/gemma-4-12b-qat
LM_STUDIO_EMBEDDING_MODEL=text-embedding-nomic-embed-text-v1.5@q8_0
EMBEDDING_DIMENSION=768

# Optional Live Provider API Keys
OPENAI_API_KEY=
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434/v1

# Default Production Guardrails
FLOWPILOT_MAX_STEPS=12
FLOWPILOT_MAX_AGENT_CALLS=15
FLOWPILOT_MAX_TOKENS_PER_WORKFLOW=10000
FLOWPILOT_EXECUTION_TIMEOUT_SECONDS=60
FLOWPILOT_MAX_RETRIES=2
FLOWPILOT_MAX_TOOL_CALLS_PER_AGENT=5
FLOWPILOT_MAX_ESCALATIONS=1
FLOWPILOT_DEFAULT_CONFIDENCE_THRESHOLD=0.80
FLOWPILOT_GLOBAL_DAILY_BUDGET_USD=100.0
FLOWPILOT_DEFAULT_USER_DAILY_BUDGET_USD=15.0
